# ── Inflate AI CRM — environment variables ──────────────────
# Only needed if/when you migrate from local storage to Supabase.
# Copy this file to `.env` (kept out of git) and fill in the values
# from your Supabase project → Project Settings → API.
#
# NOTE: the anon/public key is safe to expose in a browser app as
# long as Row Level Security (RLS) is enabled (it is, in schema.sql).

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
